# ---------------------------------------------------------------------------
# Dispositivo biometrico (ZKTeco / pyzk)
# ---------------------------------------------------------------------------
BIOMETRIC_HOST=192.168.30.90
BIOMETRIC_PORT=4370
BIOMETRIC_PASSWORD=
BIOMETRIC_TIMEOUT=10
BIOMETRIC_DEVICE_ID=alcaldia-central
# auto | tcp | udp
BIOMETRIC_TRANSPORT=auto
BIOMETRIC_ENCODING=UTF-8

# ---------------------------------------------------------------------------
# Seguridad de la API
# ---------------------------------------------------------------------------
# Token para: Authorization: Bearer <BIOMETRIC_API_TOKEN>
BIOMETRIC_API_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# Paginacion de /attendance
# ---------------------------------------------------------------------------
ATTENDANCE_DEFAULT_LIMIT=500
ATTENDANCE_MAX_LIMIT=5000

# ---------------------------------------------------------------------------
# Servicio
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# Publica /docs y /openapi.json. Dejar en false si la API queda expuesta.
BIOMETRIC_ENABLE_DOCS=false
